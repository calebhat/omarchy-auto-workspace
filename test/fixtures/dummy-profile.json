{
  "version": 2,
  "_test": {
    "id": "dummy-matrix",
    "liveWorkspaceOffset": 10,
    "appIdPrefix": "workscape-dummy",
    "notes": "Synthetic profile for the test matrix. Never write this file into ~/.local/state/omarchy/workscape/config.json. Live runs map workspace N → N+10 (11–19) and spawn foot windows with app-id workscape-dummy-*."
  },
  "settings": {
    "enabled": true,
    "applyOnBoot": false,
    "activeProfileId": "dummy-matrix",
    "silent": true,
    "onlyOnBoot": false
  },
  "monitors": [
    {
      "id": "dummy-mon",
      "label": "Dummy monitor",
      "serial": "",
      "description": "WorkScape dummy",
      "name": "DUMMY-1"
    }
  ],
  "extraApps": [],
  "profiles": [
    {
      "id": "dummy-matrix",
      "name": "Dummy matrix",
      "matchMode": "exact",
      "monitors": ["dummy-mon"],
      "workspaceMonitors": {},
      "disabledMonitors": [],
      "monitorLayout": {},
      "overflow": {
        "enabled": true,
        "workspaces": [9],
        "maxWindows": 1
      },
