#!/usr/bin/env python3
"""Bounce extras off extras=block workspaces. Hyprland owns tiling."""
from __future__ import annotations

import fcntl
import json
import os
import subprocess
import sys
import time
from importlib.machinery import SourceFileLoader
from pathlib import Path

SAFE = SourceFileLoader("workscape_hyprsafe", str(Path(__file__).resolve().parent / "hyprsafe")).load_module()
_GEOM = None


def config_path() -> Path:
    override = os.environ.get("WORKSCAPE_CONFIG", "").strip()
    if override:
        return Path(override)
    state = os.environ.get("XDG_STATE_HOME") or str(Path.home() / ".local/state")
    return Path(state) / "omarchy/workscape/config.json"


def lock_path() -> Path:
    return config_path().parent / "apply.lock"


def apply_in_progress() -> bool:
    try:
        dirfd = SAFE.open_state_dir(create=False)
    except OSError:
        return False
    try:
        lock = SAFE.try_lock(dirfd)
        if lock is None:
            return True
        fcntl.flock(lock, fcntl.LOCK_UN)
        os.close(lock)
        return False
    finally:
        os.close(dirfd)


def geom_mod():
    global _GEOM
    if _GEOM is None:
        _GEOM = SourceFileLoader("aw_geom", str(Path(__file__).resolve().parent / "geom")).load_module()
    return _GEOM


def load_active_profile() -> dict | None:
    path = config_path()
    if not path.exists():
        return None
    try:
        cfg = SAFE.load_json_file(path)
    except Exception:
        return None
    pid = ((cfg.get("settings") or {}).get("activeProfileId")) or ""
    return next((p for p in (cfg.get("profiles") or []) if p.get("id") == pid), None)


def assignment_counts(profile: dict) -> dict[str, int]:
    counts: dict[str, int] = {}
    for a in profile.get("assignments") or []:
        if a.get("enabled") is False:
            continue
        ws = str(a.get("workspace") or "")
        if ws:
            counts[ws] = counts.get(ws, 0) + 1
    return counts


def pinned_unassigned(profile: dict) -> set[str]:
    """Pinned workspaces with no apps — leave-alone (laptop, Grok CLI)."""
    assigned = set(assignment_counts(profile))
    pins = profile.get("workspaceMonitors") or {}
    out: set[str] = set()
    for key in pins:
        ws = str(key)
        if ws and ws not in assigned:
            out.add(ws)
    return out


def load_block_map() -> dict[str, int]:
    """workspace id -> max tiled windows (assignment count, min 1)."""
    profile = load_active_profile()
    if not profile:
        return {}
    prefs = profile.get("workspacePrefs") or {}
    counts = assignment_counts(profile)
    lock_place: dict[str, int] = {}
    for a in profile.get("assignments") or []:
        if a.get("enabled") is False or a.get("lockPlace") is not True:
            continue
        ws = str(a.get("workspace") or "")
        if ws:
            lock_place[ws] = lock_place.get(ws, 0) + 1
    out: dict[str, int] = {}
    keys = set(str(k) for k in prefs) | set(lock_place)
    for ws in keys:
        pref = prefs.get(ws) or prefs.get(int(ws) if str(ws).isdigit() else ws) or {}
        if not isinstance(pref, dict):
            pref = {}
        two_lock = lock_place.get(str(ws), 0) >= 2
        if pref.get("extras") != "block" and not two_lock:
            continue
        n = counts.get(str(ws), 0)
        vis = int(pref.get("visibleCount") or 2)
        vis = max(1, min(20, vis))
        out[str(ws)] = max(n, 1) if n else vis
    ov = profile.get("overflow") if isinstance(profile.get("overflow"), dict) else {}
    if ov.get("enabled") is True:
        try:
            ov_max = int(ov.get("maxWindows") or 1)
        except Exception:
            ov_max = 1
        ov_max = max(1, min(20, ov_max))
        for raw in ov.get("workspaces") or []:
            try:
                n = int(raw)
            except Exception:
                continue
            if n < 1 or n > 20:
                continue
            key = str(n)
            assigned = counts.get(key, 0)
            if key in out and assigned > 0:
                continue
            out[key] = max(assigned, ov_max) if assigned else ov_max
    return out


def overflow_order(profile: dict | None) -> list[str]:
    if not profile:
        return []
    ov = profile.get("overflow") if isinstance(profile.get("overflow"), dict) else {}
    if ov.get("enabled") is not True:
        return []
    out: list[str] = []
    seen: set[str] = set()
    for raw in ov.get("workspaces") or []:
        try:
            n = int(raw)
        except Exception:
            continue
        if n < 1 or n > 20:
            continue
        key = str(n)
        if key in seen:
            continue
        seen.add(key)
        out.append(key)
    return out


def workspace_can_accept(profile: dict, ws: str, blocked: dict[str, int]) -> bool:
    """True if sending an extra here will not immediately bounce or land on a preset."""
    dest = str(ws)
    cap = blocked.get(dest)
    if cap is not None:
        if int(cap) <= 0:
            return False
        if window_count(dest) >= int(cap):
            return False
    prefs = profile.get("workspacePrefs") or {}
    pref = prefs.get(dest) if isinstance(prefs.get(dest), dict) else {}
    if pref.get("extras") == "block" and cap is None:
        return False
    chain = set(overflow_order(profile))
    if dest in chain:
        return cap is None or window_count(dest) < int(cap)
    if dest in pinned_unassigned(profile):
        return False
    if dest in assignment_counts(profile):
        # Empty preset workspaces can take overflow. Occupied ones cannot
        # (I-051: skipping empty WS4 sent ShopHawk extras to WS5).
        return window_count(dest) == 0
    return True


def next_open_ws(blocked: dict[str, int], current: str, profile: dict | None = None) -> str | None:
    order = overflow_order(profile)
    if order:
        if current in order:
            idx = order.index(current)
            seq = order[idx + 1 :] + order[:idx]
        else:
            seq = order
        for dest in seq:
            if profile is None or workspace_can_accept(profile, dest, blocked):
                return dest
        return None
    try:
        cur = int(current)
    except Exception:
        return None
    for n in list(range(cur + 1, 21)) + list(range(1, cur)):
        dest = str(n)
        if profile is not None:
            if not workspace_can_accept(profile, dest, blocked):
                continue
        elif dest in blocked:
            continue
        return dest
    return None


def window_count(ws: str) -> int:
    try:
        clients = SAFE.hypr_json(["clients"])
    except Exception:
        return -1
    n = 0
    for c in clients:
        w = c.get("workspace") or {}
        if str(w.get("id")) == str(ws) or str(w.get("name")) == str(ws):
            n += 1
    return n


def client_by_addr(addr: str) -> dict | None:
    want = str(addr or "")
    if not want:
        return None
    try:
        clients = SAFE.hypr_json(["clients"])
    except Exception:
        return None
    return next((c for c in (clients or []) if str(c.get("address") or "") == want), None)


def hypr_eval(lua: str) -> None:
    try:
        subprocess.run(
            ["hyprctl", "eval", lua],
            check=False,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            timeout=2,
        )
    except subprocess.TimeoutExpired:
        pass


def move_to_ws(addr: str, ws: str) -> None:
    addr = SAFE.safe_addr(addr)
    ws = SAFE.safe_ws(ws)
    if not addr or not ws:
        return
    hypr_eval(
        f'hl.dispatch(hl.dsp.window.move({{workspace="{ws}", window="address:{addr}", follow=false}}))'
    )


def focus_ws_and_window(ws: str, addr: str) -> None:
    addr = SAFE.safe_addr(addr)
    ws = SAFE.safe_ws(ws)
    if not ws:
        return
    hypr_eval(f'hl.dispatch(hl.dsp.focus({{ workspace = "{ws}" }}))')
    if addr:
        hypr_eval(f'hl.dispatch(hl.dsp.focus({{ window = "address:{addr}" }}))')


def socket_path() -> Path | None:
    his = os.environ.get("HYPRLAND_INSTANCE_SIGNATURE", "")
    runtime = os.environ.get("XDG_RUNTIME_DIR") or f"/run/user/{os.getuid()}"
    base = Path(runtime) / "hypr"
    if his:
        p = base / his / ".socket2.sock"
        if p.exists():
            return p
    if not base.exists():
        return None
    for child in sorted(base.iterdir(), reverse=True):
        sock = child / ".socket2.sock"
        if sock.exists():
            return sock
    return None


def window_is_assigned(client: dict, profile: dict, ws: str) -> bool:
    cls = str(client.get("class") or "").lower()
    title = str(client.get("title") or "").lower()
    initial = str(client.get("initialClass") or "").lower()
    cls_cmp = cls.replace(".", "-")
    for a in profile.get("assignments") or []:
        if str(a.get("workspace") or "") != str(ws) or a.get("enabled") is False:
            continue
        name = str(a.get("name") or "").strip().lower()
        if name and (name in title or name in cls or name in initial):
            return True
        exec_cmd = str(a.get("exec") or a.get("command") or "")
        app_id = geom_mod().exec_app_id(exec_cmd)
        if app_id and (app_id == cls or app_id == initial or app_id in cls):
            return True
        exec_s = exec_cmd.split()
        if not exec_s:
            continue
        base = exec_s[0].rstrip("/").split("/")[-1].lower()
        if base and (base in cls or base in cls_cmp):
            return True
        for part in base.replace("-", " ").split():
            if len(part) >= 4 and part in cls:
                return True
    return False


def bounce_if_blocked(addr: str, ws: str) -> bool:
    """Move addr off an extras=block workspace that is over cap. True if moved."""
    if apply_in_progress():
        return False
    hit = client_by_addr(addr)
    if hit and hit.get("floating"):
        return False
    blocked = load_block_map()
    if str(ws) not in blocked:
        return False
    cap = int(blocked[ws])
    time.sleep(0.08)
    if window_count(ws) <= cap:
        return False
    profile = load_active_profile()
    dest = next_open_ws(blocked, ws, profile)
    if not dest:
        return False
    move_to_ws(addr, dest)
    time.sleep(0.08)
    focus_ws_and_window(dest, addr)
    print(json.dumps({"moved": addr, "from": ws, "to": dest}), flush=True)
    return True


def handle_open(addr: str, ws: str) -> None:
    bounce_if_blocked(addr, ws)


def sweep_block_extras() -> list[dict]:
    """After apply, move leftover extras off extras=block workspaces."""
    profile = load_active_profile()
    if not profile:
        return []
    blocked = load_block_map()
    if not blocked:
        return []
    try:
        clients = SAFE.hypr_json(["clients"])
    except Exception:
        return []
    occupied = {s for s in os.environ.get("WORKSCAPE_OCCUPIED_WS", "").split() if s}
    moved: list[dict] = []
    for ws, cap in blocked.items():
        if str(ws) in occupied:
            continue
        on_ws = [c for c in clients if str((c.get("workspace") or {}).get("id")) == str(ws)]
        if len(on_ws) <= cap:
            continue
        extras = [c for c in on_ws if not window_is_assigned(c, profile, ws)]
        keepers = [c for c in on_ws if window_is_assigned(c, profile, ws)]
        overflow = extras + keepers[cap:]
        dest = next_open_ws(blocked, ws, profile)
        if not dest:
            continue
        for c in overflow:
            addr = str(c.get("address") or "")
            if not addr:
                continue
            move_to_ws(addr, dest)
            moved.append({"addr": addr, "from": ws, "to": dest, "class": c.get("class")})
        clients = [c for c in clients if c.get("address") not in {m["addr"] for m in moved}]
    if moved:
        print(json.dumps({"sweep": moved}), flush=True)
    return moved


def apply_focus_chrome() -> None:
    profile = load_active_profile()
    if not profile:
        return
    if not any(isinstance(a.get("chrome"), dict) for a in (profile.get("assignments") or [])):
        return
    try:
        active = SAFE.hypr_json(["activewindow"])
        clients = SAFE.hypr_json(["clients"])
    except Exception:
        return
    focus = str((active or {}).get("address") or "")
    geom = geom_mod()
    used: set[str] = set()
    for a in profile.get("assignments") or []:
        chrome = a.get("chrome")
        if not isinstance(chrome, dict):
            continue
        ws = str(a.get("workspace") or "")
        on_ws = [c for c in clients if str((c.get("workspace") or {}).get("id")) == ws]
        hit = None
        name = str(a.get("name") or "").strip().lower()
        exec_s = str(a.get("exec") or a.get("command") or "").split()
        base = exec_s[0].rstrip("/").split("/")[-1].lower() if exec_s else ""
        for c in on_ws:
            addr = str(c.get("address") or "")
            if addr in used:
                continue
            cls = str(c.get("class") or "").lower()
            title = str(c.get("title") or "").lower()
            if base and (base in cls or base.replace("-", "") in cls.replace("-", "").replace(".", "")):
                hit = c
                break
            if name and len(name) >= 5 and name in title:
                hit = c
                break
        if not hit:
            continue
        addr = str(hit.get("address") or "")
        used.add(addr)
        geom.apply_chrome(addr, chrome, addr == focus)


def _handle_event_line(line: str) -> None:
    if line.startswith("openwindow>>"):
        payload = line.split(">>", 1)[1]
        parts = payload.split(",", 3)
        if len(parts) < 2:
            return
        addr, ws = parts[0], parts[1]
        if addr and not addr.startswith("0x"):
            addr = "0x" + addr
        if addr and ws and ws.isdigit():
            handle_open(addr, ws)
        return
    if line.startswith("monitoradded") or line.startswith("monitorremoved"):
        print(json.dumps({"monitorChange": True}), flush=True)
        return
    if line.startswith("activewindow>>") or line.startswith("activewindowv2>>"):
        apply_focus_chrome()


def _consume_socket(proc: subprocess.Popen) -> None:
    assert proc.stdout
    buf = bytearray()
    fd = proc.stdout.fileno()
    while True:
        chunk = os.read(fd, 1024)
        if not chunk:
            break
        buf.extend(chunk)
        while True:
            nl = buf.find(b"\n")
            if nl < 0:
                if len(buf) > SAFE.MAX_EVENT_LINE:
                    SAFE.kill_group(proc.pid)
                    return
                break
            raw = bytes(buf[:nl])
            del buf[: nl + 1]
            if len(raw) > SAFE.MAX_EVENT_LINE:
                SAFE.kill_group(proc.pid)
                return
            line = raw.decode("utf-8", "replace").strip()
            if line:
                _handle_event_line(line)


def main() -> int:
    if "--sweep" in sys.argv:
        sweep_block_extras()
        return 0
    while True:
        sock = socket_path()
        if not sock:
            time.sleep(1.0)
            continue
        proc = subprocess.Popen(
            ["socat", "-u", f"UNIX-CONNECT:{sock}", "-"],
            stdout=subprocess.PIPE,
            start_new_session=True,
            preexec_fn=SAFE._pdeathsig,
        )
        try:
            _consume_socket(proc)
        finally:
            try:
                proc.kill()
            except Exception:
                pass
        time.sleep(0.5)
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
