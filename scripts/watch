#!/usr/bin/env python3
"""Keep locked panes pinned and send extras away when extras=block."""
from __future__ import annotations

import json
import os
import subprocess
import sys
import time
from importlib.machinery import SourceFileLoader
from pathlib import Path


def config_path() -> Path:
    state = os.environ.get("XDG_STATE_HOME") or str(Path.home() / ".local/state")
    return Path(state) / "omarchy/scenebook/config.json"


def lock_path() -> Path:
    return config_path().parent / "apply.lock"


def apply_in_progress() -> bool:
    lock = lock_path()
    if not lock.exists():
        return False
    try:
        return subprocess.call(["flock", "-n", str(lock), "-c", "true"]) != 0
    except Exception:
        return False


def geom_mod():
    return SourceFileLoader("aw_geom", str(Path(__file__).resolve().parent / "geom")).load_module()


def load_block_map() -> dict[str, int]:
    """workspace id -> max windows allowed (assignment count, min 1)."""
    path = config_path()
    if not path.exists():
        return {}
    try:
        cfg = json.loads(path.read_text())
    except Exception:
        return {}
    pid = ((cfg.get("settings") or {}).get("activeProfileId")) or ""
    profile = next((p for p in (cfg.get("profiles") or []) if p.get("id") == pid), None)
    if not profile:
        return {}
    prefs = profile.get("workspacePrefs") or {}
    counts: dict[str, int] = {}
    for a in profile.get("assignments") or []:
        if a.get("enabled") is False:
            continue
        ws = str(a.get("workspace") or "")
        counts[ws] = counts.get(ws, 0) + 1
    out = {}
    for ws, pref in prefs.items():
        if not isinstance(pref, dict) or pref.get("extras") != "block":
            continue
        n = counts.get(str(ws), 0)
        vis = int(pref.get("visibleCount") or 2)
        out[str(ws)] = max(n, 1) if n else max(1, min(20, vis))
    return out


def next_open_ws(blocked: dict[str, int], current: str) -> str | None:
    try:
        cur = int(current)
    except Exception:
        return None
    for n in list(range(cur + 1, 11)) + list(range(1, cur)):
        if str(n) not in blocked:
            return str(n)
    return None


def window_count(ws: str) -> int:
    try:
        clients = json.loads(subprocess.check_output(["hyprctl", "-j", "clients"], text=True))
    except Exception:
        return 0
    n = 0
    for c in clients:
        w = c.get("workspace") or {}
        if str(w.get("id")) == str(ws) or str(w.get("name")) == str(ws):
            n += 1
    return n


def move_to_ws(addr: str, ws: str) -> None:
    lua = f'hl.dispatch(hl.dsp.window.move({{workspace="{ws}", window="address:{addr}", follow=false}}))'
    subprocess.run(["hyprctl", "eval", lua], check=False, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


def socket_path() -> Path | None:
    his = os.environ.get("HYPRLAND_INSTANCE_SIGNATURE", "")
    runtime = os.environ.get("XDG_RUNTIME_DIR") or f"/run/user/{os.getuid()}"
    base = Path(runtime) / "hypr"
    if his:
        p = base / his / ".socket2.sock"
        if p.exists():
            return p
    if not base.exists():
        return None
    for child in sorted(base.iterdir(), reverse=True):
        sock = child / ".socket2.sock"
        if sock.exists():
            return sock
    return None


def locked_workspaces() -> list[str]:
    path = config_path()
    if not path.exists():
        return []
    try:
        cfg = json.loads(path.read_text())
    except Exception:
        return []
    g = geom_mod()
    profile = g.active_profile(cfg)
    if not profile:
        return []
    out: list[str] = []
    seen: set[str] = set()
    prefs = profile.get("workspacePrefs") or {}
    for ws, pref in prefs.items():
        if isinstance(pref, dict) and pref.get("lockSizes") is True:
            seen.add(str(ws))
    for a in profile.get("assignments") or []:
        if a.get("enabled") is False:
            continue
        if a.get("lockPlace") is True:
            seen.add(str(a.get("workspace") or ""))
    for ws in seen:
        if ws and ws != "None":
            out.append(ws)
    return out


_restoring = False
_last_restore: dict[str, float] = {}


def restore_locks(ws: str, addr: str = "") -> None:
    global _restoring
    if _restoring:
        return
    _restoring = True
    _last_restore[str(ws)] = time.monotonic()
    try:
        result = geom_mod().restore_locks_for_workspace(str(ws), prefer_addr=addr or "")
        if result and not result.get("skipped"):
            print(json.dumps({"restore": str(ws), "ok": result.get("ok"), "closeEnough": result.get("closeEnough")}), flush=True)
    except Exception as exc:
        print(json.dumps({"restore": str(ws), "ok": False, "error": str(exc)}), flush=True)
    finally:
        _restoring = False


def handle_open(addr: str, ws: str) -> None:
    if apply_in_progress():
        return
    blocked = load_block_map()
    time.sleep(0.12)
    if ws in blocked:
        if window_count(ws) > blocked[ws]:
            dest = next_open_ws(blocked, ws)
            if dest:
                move_to_ws(addr, dest)
                time.sleep(0.05)
                if str(ws) in locked_workspaces():
                    restore_locks(ws, "")
                return
    if str(ws) in locked_workspaces():
        restore_locks(ws, addr)


def handle_close_or_move(ws: str | None) -> None:
    # closewindow / our own swapcol must not re-enter restore (that fight
    # squeezed extras to width -3). Only admit extras on openwindow.
    return


def main() -> int:
    sock = socket_path()
    if not sock:
        print("no hypr socket2", file=sys.stderr)
        return 1
    proc = subprocess.Popen(
        ["socat", "-u", f"UNIX-CONNECT:{sock}", "-"],
        stdout=subprocess.PIPE,
        text=True,
    )
    assert proc.stdout
    for line in proc.stdout:
        line = line.strip()
        if line.startswith("openwindow>>"):
            payload = line.split(">>", 1)[1]
            parts = payload.split(",", 3)
            if len(parts) < 2:
                continue
            addr, ws = parts[0], parts[1]
            if addr and ws and ws.isdigit():
                handle_open(addr, ws)
            continue
        if line.startswith("movewindow>>") or line.startswith("movewindowv2>>"):
            payload = line.split(">>", 1)[1]
            parts = payload.split(",", 2)
            if len(parts) >= 2 and parts[1].isdigit():
                handle_close_or_move(parts[1])
            continue
        if line.startswith("closewindow>>"):
            handle_close_or_move(None)
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
