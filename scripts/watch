#!/usr/bin/env python3
"""Keep locked panes pinned and send extras away when extras=block."""
from __future__ import annotations

import json
import os
import subprocess
import sys
import time
from importlib.machinery import SourceFileLoader
from pathlib import Path

SAFE = SourceFileLoader("workscape_hyprsafe", str(Path(__file__).resolve().parent / "hyprsafe")).load_module()
_GEOM = None


def config_path() -> Path:
    state = os.environ.get("XDG_STATE_HOME") or str(Path.home() / ".local/state")
    return Path(state) / "omarchy/workscape/config.json"


def lock_path() -> Path:
    return config_path().parent / "apply.lock"


def apply_in_progress() -> bool:
    lock = lock_path()
    if not lock.exists():
        return False
    try:
        return subprocess.call(["flock", "-n", str(lock), "-c", "true"]) != 0
    except Exception:
        return False


def geom_mod():
    global _GEOM
    if _GEOM is None:
        _GEOM = SourceFileLoader("aw_geom", str(Path(__file__).resolve().parent / "geom")).load_module()
    return _GEOM


def load_block_map() -> dict[str, int]:
    """workspace id -> max windows allowed (assignment count, min 1)."""
    path = config_path()
    if not path.exists():
        return {}
    try:
        cfg = json.loads(path.read_text())
    except Exception:
        return {}
    pid = ((cfg.get("settings") or {}).get("activeProfileId")) or ""
    profile = next((p for p in (cfg.get("profiles") or []) if p.get("id") == pid), None)
    if not profile:
        return {}
    prefs = profile.get("workspacePrefs") or {}
    counts: dict[str, int] = {}
    for a in profile.get("assignments") or []:
        if a.get("enabled") is False:
            continue
        ws = str(a.get("workspace") or "")
        counts[ws] = counts.get(ws, 0) + 1
    out = {}
    for ws, pref in prefs.items():
        if not isinstance(pref, dict) or pref.get("extras") != "block":
            continue
        n = counts.get(str(ws), 0)
        vis = int(pref.get("visibleCount") or 2)
        out[str(ws)] = max(n, 1) if n else max(1, min(20, vis))
    ov = profile.get("overflow") if isinstance(profile.get("overflow"), dict) else {}
    if ov.get("enabled") is True:
        try:
            ov_max = int(ov.get("maxWindows") or 1)
        except Exception:
            ov_max = 1
        if ov_max < 1:
            ov_max = 1
        if ov_max > 20:
            ov_max = 20
        for raw in ov.get("workspaces") or []:
            try:
                n = int(raw)
            except Exception:
                continue
            if n < 1 or n > 20:
                continue
            key = str(n)
            assigned = counts.get(key, 0)
            if key in out and assigned > 0:
                continue
            out[key] = max(assigned, ov_max) if assigned else ov_max
    return out


def overflow_order(profile: dict | None) -> list[str]:
    if not profile:
        return []
    ov = profile.get("overflow") if isinstance(profile.get("overflow"), dict) else {}
    if ov.get("enabled") is not True:
        return []
    out: list[str] = []
    seen: set[str] = set()
    for raw in ov.get("workspaces") or []:
        try:
            n = int(raw)
        except Exception:
            continue
        if n < 1 or n > 20:
            continue
        key = str(n)
        if key in seen:
            continue
        seen.add(key)
        out.append(key)
    return out


def workspace_can_accept(profile: dict, ws: str, blocked: dict[str, int]) -> bool:
    """True if sending an extra window here will not immediately bounce."""
    cap = blocked.get(str(ws))
    if cap is not None:
        if int(cap) <= 0:
            return False
        if window_count(ws) >= int(cap):
            return False
        return True
    prefs = profile.get("workspacePrefs") or {}
    pref = prefs.get(str(ws)) if isinstance(prefs.get(str(ws)), dict) else {}
    if pref.get("extras") == "block":
        return False
    return True


def load_active_profile() -> dict | None:
    path = config_path()
    if not path.exists():
        return None
    try:
        cfg = json.loads(path.read_text())
    except Exception:
        return None
    pid = ((cfg.get("settings") or {}).get("activeProfileId")) or ""
    return next((p for p in (cfg.get("profiles") or []) if p.get("id") == pid), None)


def next_open_ws(blocked: dict[str, int], current: str, profile: dict | None = None) -> str | None:
    order = overflow_order(profile)
    if order:
        if current in order:
            idx = order.index(current)
            seq = order[idx + 1 :] + order[:idx]
        else:
            seq = order
        for dest in seq:
            if profile is None or workspace_can_accept(profile, dest, blocked):
                return dest
        return None
    try:
        cur = int(current)
    except Exception:
        return None
    for n in list(range(cur + 1, 21)) + list(range(1, cur)):
        dest = str(n)
        if profile is not None:
            if not workspace_can_accept(profile, dest, blocked):
                continue
        elif dest in blocked:
            continue
        return dest
    return None


def window_count(ws: str) -> int:
    try:
        clients = json.loads(subprocess.check_output(["hyprctl", "-j", "clients"], text=True))
    except Exception:
        return 0
    n = 0
    for c in clients:
        w = c.get("workspace") or {}
        if str(w.get("id")) == str(ws) or str(w.get("name")) == str(ws):
            n += 1
    return n


def hypr_eval(lua: str) -> None:
    subprocess.run(["hyprctl", "eval", lua], check=False, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


def move_to_ws(addr: str, ws: str) -> None:
    addr = SAFE.safe_addr(addr)
    ws = SAFE.safe_ws(ws)
    if not addr or not ws:
        return
    hypr_eval(
        f'hl.dispatch(hl.dsp.window.move({{workspace="{ws}", window="address:{addr}", follow=true}}))'
    )


def focus_ws_and_window(ws: str, addr: str) -> None:
    addr = SAFE.safe_addr(addr)
    ws = SAFE.safe_ws(ws)
    if not ws:
        return
    hypr_eval(f'hl.dispatch(hl.dsp.focus({{ workspace = "{ws}" }}))')
    if addr:
        hypr_eval(f'hl.dispatch(hl.dsp.focus({{ window = "address:{addr}" }}))')


def socket_path() -> Path | None:
    his = os.environ.get("HYPRLAND_INSTANCE_SIGNATURE", "")
    runtime = os.environ.get("XDG_RUNTIME_DIR") or f"/run/user/{os.getuid()}"
    base = Path(runtime) / "hypr"
    if his:
        p = base / his / ".socket2.sock"
        if p.exists():
            return p
    if not base.exists():
        return None
    for child in sorted(base.iterdir(), reverse=True):
        sock = child / ".socket2.sock"
        if sock.exists():
            return sock
    return None


def locked_workspaces() -> list[str]:
    path = config_path()
    if not path.exists():
        return []
    try:
        cfg = json.loads(path.read_text())
    except Exception:
        return []
    g = geom_mod()
    profile = g.active_profile(cfg)
    if not profile:
        return []
    out: list[str] = []
    seen: set[str] = set()
    prefs = profile.get("workspacePrefs") or {}
    for ws, pref in prefs.items():
        if isinstance(pref, dict) and pref.get("lockSizes") is True:
            seen.add(str(ws))
    for a in profile.get("assignments") or []:
        if a.get("enabled") is False:
            continue
        if a.get("lockPlace") is True:
            seen.add(str(a.get("workspace") or ""))
    for ws in seen:
        if ws and ws != "None":
            out.append(ws)
    return out


_restoring = False
_last_restore: dict[str, float] = {}
STARTED_AT = time.monotonic()
STARTUP_GRACE_SEC = 4.0


def in_startup_grace() -> bool:
    return time.monotonic() - STARTED_AT < STARTUP_GRACE_SEC


def restore_locks(ws: str, addr: str = "") -> None:
    global _restoring
    if _restoring:
        return
    _restoring = True
    _last_restore[str(ws)] = time.monotonic()
    try:
        result = geom_mod().restore_locks_for_workspace(str(ws), prefer_addr=addr or "")
        if result and not result.get("skipped"):
            print(json.dumps({"restore": str(ws), "ok": result.get("ok"), "closeEnough": result.get("closeEnough")}), flush=True)
    except Exception as exc:
        print(json.dumps({"restore": str(ws), "ok": False, "error": str(exc)}), flush=True)
    finally:
        _restoring = False


def handle_open(addr: str, ws: str) -> None:
    if apply_in_progress():
        return
    blocked = load_block_map()
    locked = locked_workspaces()
    if not blocked and not locked:
        return
    profile = load_active_profile()
    if ws in blocked:
        cap = int(blocked[ws])
        over = False
        for _ in range(10):
            if window_count(ws) > cap:
                over = True
                break
            time.sleep(0.05)
        if over:
            dest = next_open_ws(blocked, ws, profile)
            if dest:
                move_to_ws(addr, dest)
                if str(ws) in locked:
                    restore_locks(ws, "")
                time.sleep(0.08)
                focus_ws_and_window(dest, addr)
                print(json.dumps({"moved": addr, "from": ws, "to": dest}), flush=True)
                return
    if in_startup_grace():
        return
    if str(ws) in locked:
        restore_locks(ws, addr)


def window_is_assigned(client: dict, profile: dict, ws: str) -> bool:
    cls = str(client.get("class") or "").lower()
    title = str(client.get("title") or "").lower()
    cls_cmp = cls.replace(".", "-")
    for a in profile.get("assignments") or []:
        if str(a.get("workspace") or "") != str(ws) or a.get("enabled") is False:
            continue
        name = str(a.get("name") or "").strip().lower()
        if name and name in title:
            return True
        exec_s = str(a.get("exec") or a.get("command") or "").split()
        if not exec_s:
            continue
        base = exec_s[0].rstrip("/").split("/")[-1].lower()
        if base and (base in cls or base in cls_cmp):
            return True
        for part in base.replace("-", " ").split():
            if len(part) >= 4 and part in cls:
                return True
    return False


def sweep_block_extras() -> list[dict]:
    """After apply, move leftover extras off extras=block workspaces."""
    profile = load_active_profile()
    if not profile:
        return []
    blocked = load_block_map()
    if not blocked:
        return []
    try:
        clients = json.loads(subprocess.check_output(["hyprctl", "-j", "clients"], text=True))
    except Exception:
        return []
    moved: list[dict] = []
    for ws, cap in blocked.items():
        on_ws = [c for c in clients if str((c.get("workspace") or {}).get("id")) == str(ws)]
        if len(on_ws) <= cap:
            continue
        extras = [c for c in on_ws if not window_is_assigned(c, profile, ws)]
        keepers = [c for c in on_ws if window_is_assigned(c, profile, ws)]
        overflow = extras + keepers[cap:]
        dest = next_open_ws(blocked, ws, profile)
        if not dest:
            continue
        for c in overflow:
            addr = str(c.get("address") or "")
            if not addr:
                continue
            move_to_ws(addr, dest)
            moved.append({"addr": addr, "from": ws, "to": dest, "class": c.get("class")})
        clients = [c for c in clients if c.get("address") not in {m["addr"] for m in moved}]
    if moved:
        print(json.dumps({"sweep": moved}), flush=True)
    return moved


def handle_close_or_move(ws: str | None) -> None:
    # closewindow / our own swapcol must not re-enter restore (that fight
    # squeezed extras to width -3). Only admit extras on openwindow.
    return


def main() -> int:
    if "--sweep" in sys.argv:
        sweep_block_extras()
        return 0
    sock = socket_path()
    if not sock:
        print("no hypr socket2", file=sys.stderr)
        return 1
    proc = subprocess.Popen(
        ["socat", "-u", f"UNIX-CONNECT:{sock}", "-"],
        stdout=subprocess.PIPE,
        text=True,
    )
    assert proc.stdout
    for line in proc.stdout:
        line = line.strip()
        if line.startswith("openwindow>>"):
            payload = line.split(">>", 1)[1]
            parts = payload.split(",", 3)
            if len(parts) < 2:
                continue
            addr, ws = parts[0], parts[1]
            if addr and ws and ws.isdigit():
                handle_open(addr, ws)
            continue
        if line.startswith("movewindow>>") or line.startswith("movewindowv2>>"):
            payload = line.split(">>", 1)[1]
            parts = payload.split(",", 2)
            if len(parts) >= 2 and parts[1].isdigit():
                handle_close_or_move(parts[1])
            continue
        if line.startswith("closewindow>>"):
            handle_close_or_move(None)
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
